# Copy to credentials.local.env if setting up a new checkout.
# Use API tokens from Xcode, not your account password.
# Separate tokens may be needed because each token belongs to a model group.
XCODE_GPT_API_KEY=
XCODE_CLAUDE_API_KEY=
XCODE_GEMINI_API_KEY=
# Optional shared token, only if its group supports the models you selected.
XCODE_API_KEY=
