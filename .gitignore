# Python/cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.ipynb

# Local editors
.vscode/
.idea/

# ---- 本地私有配置（含 GPT-6 中转站密钥，禁止入库）----
configs/*.local.env
*.local.env

# ---- 新系统（§2 目录树）----
# 数据集与重建产物不入库（§2：data/ 不入库；DVC/软链）
/data/**
!/data/.gitkeep
/data/.gitkeep

# ---- legacy Skill-3D 参考代码（legacy/，见 legacy/README.md）----
# Datasets and generated samples. Keep dataset utility code only.
/dataset/*
!/dataset/*.py
!/dataset/*.sh
!/dataset/README.md
/temp_frames/
/repro_examples/
/test_data/
/test_outputs/

# Checkpoints, model links, and heavyweight third-party assets. Keep only the
# public checkpoints/ directory skeleton through .gitkeep files.
/legacy/checkpoints/**
!/legacy/checkpoints/
!/legacy/checkpoints/**/
!/legacy/checkpoints/**/.gitkeep
/model_links/
/models/
/Qwen*/
/SPAgent-*/
/bert-base-uncased/
/clip-vit-large-patch14/
/models--*/
/GroundingDINO/weights/
/legacy/third_party/**/weights/
/legacy/third_party/**/checkpoints/

# Runtime outputs.
/logs/
/results/
/output/
/outputs/
/outputs_old/
/wandb/
/legacy/train/logs/
/legacy/train/temp_frames_train/

# Learned memories/skills are generated artifacts. The public repository keeps
# the statics/skill3d_shared directory skeleton through README.md/.gitkeep only.
/legacy/statics/skill3d_by_benchmark/
/legacy/statics/learned*.json
/legacy/statics/skill3d_shared/**/*.json
/legacy/statics/skill3d_shared/**/*.jsonl
!/legacy/statics/
!/legacy/statics/skill3d_shared/
!/legacy/statics/skill3d_shared/**/
!/legacy/statics/skill3d_shared/README.md
!/legacy/statics/skill3d_shared/**/.gitkeep

# Large model/media/result files.
*.safetensors
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.engine
*.mp4
*.mov
*.avi
*.mkv
*.jpg
*.jpeg
*.png
*.webp
!/legacy/assets/
!/legacy/assets/.gitkeep
!/legacy/assets/main.png
!/legacy/assets/motivation.png
*.ply
*.pcd
*.npy
