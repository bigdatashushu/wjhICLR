# Skill3D Program Sandbox 镜像（系统架构.md §13.2 / M10）
# 安全姿态：只读根 FS + tmpfs 可写层 + --network none + 不挂 GPU（运行时参数见 configs/sandbox_docker.yaml）
FROM python:3.11-slim

# 仅安装白名单库（与 M9 AST 白名单一致：numpy/scipy/math/statistics）
RUN pip install --no-cache-dir numpy scipy

# 非 root 运行
RUN useradd -m sandbox
USER sandbox
WORKDIR /home/sandbox

# 入口：执行经 M9 AST 检查后的 episode-specific program
COPY docker/run_program.py /home/sandbox/run_program.py
ENTRYPOINT ["python", "run_program.py"]
